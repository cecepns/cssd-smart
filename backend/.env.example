PORT=5000
NODE_ENV=development

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cssd_smart

# Auth (WAJIB diganti di production)
JWT_SECRET=ganti-dengan-secret-panjang-dan-acak
JWT_EXPIRES_IN=12h

# CORS: pisahkan dengan koma jika lebih dari satu origin
CORS_ORIGIN=http://localhost:5173

# Upload
UPLOAD_DIR=uploads-cssd-smart

# Aplikasi
APP_TIMEZONE=Asia/Jakarta
DEFAULT_SHELF_LIFE_MONTHS=6

# Akun admin awal (dibuat otomatis jika tabel users masih kosong)
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
